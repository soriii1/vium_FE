{
  "expo": {
    "name": "vium_app",
    "slug": "vium_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "viumapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B2E194"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Paperlogy-1Thin.ttf",
            "./assets/fonts/Paperlogy-2ExtraLight.ttf",
            "./assets/fonts/Paperlogy-3Light.ttf",
            "./assets/fonts/Paperlogy-4Regular.ttf",
            "./assets/fonts/Paperlogy-5Medium.ttf",
            "./assets/fonts/Paperlogy-6SemiBold.ttf",
            "./assets/fonts/Paperlogy-7Bold.ttf",
            "./assets/fonts/Paperlogy-8ExtraBold.ttf",
            "./assets/fonts/Paperlogy-9Black.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앱에서 사진을 선택할 수 있도록 허용해주세요.",
          "cameraPermission": "앱에서 카메라를 사용할 수 있도록 허용해주세요."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "061074a9-2855-4362-9833-31427026dd41"
      },
      "apiBaseUrl": "https://api.vium.site"
    }
  }
}
